# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Neon or Supabase) -------------------------------------------
# Use the POOLED connection string (Neon: the "-pooler" host; Supabase: port 6543).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth.js ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# The single account allowed to sign in.
AUTH_USER_EMAIL=""
# Generate with: npm run hash-password -- 'your-password-here'
AUTH_USER_PASSWORD_HASH=""

# --- Anthropic --------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# --- Notion (optional) ------------------------------------------------------
# Create an internal integration at https://www.notion.so/my-integrations,
# then share the pages/databases you want to expose with that integration.
NOTION_INTEGRATION_TOKEN=""

# --- Google Drive (optional) ------------------------------------------------
# Same model as Notion — a machine identity you share files with, not OAuth.
#   1. Google Cloud Console: create a project, enable the Drive API and Docs API.
#   2. Create a service account, add a JSON key, download it.
#   3. Paste the ENTIRE key file below, on one line.
#   4. In Drive, share the folders/files you want with the service account's
#      `client_email`. Nothing is visible until you do.
# Access is read-only (drive.readonly scope).
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Neon or Supabase) -------------------------------------------
# Use the POOLED connection string (Neon: the "-pooler" host; Supabase: port 6543).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth.js ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# The single account allowed to sign in.
AUTH_USER_EMAIL=""
# Generate with: npm run hash-password -- 'your-password-here'
AUTH_USER_PASSWORD_HASH=""

# --- Anthropic --------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# --- Notion (optional; the Sources pane is inert without it) ----------------
# Create an internal integration at https://www.notion.so/my-integrations,
# then share the pages/databases you want to expose with that integration.
NOTION_INTEGRATION_TOKEN=""
